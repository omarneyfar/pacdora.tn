{
  "id": "reverse-tuck-end-v2",
  "schemaVersion": "dieline-recipe-1.0",
  "category": "folding-box",
  "family": "reverse-tuck-end",
  "label": "Reverse Tuck End Folding Carton Box",
  "productionReady": false,
  "verificationStatus": "geometry-needs-verification",
  "parameters": {
    "L": { "label": "Length(L)", "kind": "dimension", "input": "number", "default": 120.65, "min": 10, "max": 800, "step": 1, "unit": "mm" },
    "W": { "label": "Width(W)", "kind": "dimension", "input": "number", "default": 60.72, "min": 8, "max": 500, "step": 1, "unit": "mm" },
    "H": { "label": "Height(H)", "kind": "dimension", "input": "number", "default": 161.13, "min": 10, "max": 900, "step": 1, "unit": "mm" },
    "closureMode": {
      "label": "Closure dimensions",
      "kind": "closure",
      "input": "select",
      "default": "auto",
      "options": [
        { "label": "Auto", "value": "auto" },
        { "label": "Manual", "value": "manual" }
      ]
    },
    "outputSizeMode": {
      "label": "Output Size Mode",
      "kind": "export",
      "input": "select",
      "default": "inner",
      "options": [
        { "label": "Inner dimensions", "value": "inner" },
        { "label": "Outer dimensions", "value": "outer" }
      ]
    },
    "materialThickness": { "label": "Material Thickness", "kind": "material", "input": "number", "default": 1.5, "min": 0, "max": 12, "step": 0.1, "unit": "mm" },
    "material": {
      "label": "Material",
      "kind": "material",
      "input": "select",
      "default": "E-flute paper",
      "options": [
        { "label": "E-flute paper", "value": "E-flute paper" },
        { "label": "Cardboard", "value": "Cardboard" },
        { "label": "Kraft paper", "value": "Kraft paper" }
      ]
    },
    "bleeds": {
      "label": "Bleeds",
      "kind": "export",
      "input": "select",
      "default": "none",
      "options": [
        { "label": "No bleeds", "value": "none" },
        { "label": "3 mm", "value": 3 },
        { "label": "5 mm", "value": 5 }
      ]
    },
    "pdfExport": { "label": "PDF for Dielines", "kind": "export", "input": "boolean", "default": true },
    "dxfExport": { "label": "DXF for Dielines", "kind": "export", "input": "boolean", "default": true },
    "TFW": { "label": "Tuck flap lip", "kind": "closure", "input": "number", "default": "clamp(W * 0.32, W * 0.22, W * 0.45)", "min": "W * 0.15", "max": "W * 0.6", "step": 0.5, "unit": "mm" },
    "TFR": { "label": "Tuck flap radius", "kind": "closure", "input": "number", "default": "clamp(W * 0.25, 4, min(W * 0.35, L * 0.2))", "min": 0, "max": "min(W * 0.5, L * 0.25)", "step": 0.5, "unit": "mm" },
    "GFW": { "label": "Glue tab width", "kind": "closure", "input": "number", "default": "clamp(W * 0.25, 10, 22)", "min": 10, "max": 22, "step": 0.5, "unit": "mm" },
    "DFW": { "label": "Dust flap depth", "kind": "closure", "input": "number", "default": "clamp(W * 0.58, W * 0.45, W * 0.75)", "min": "W * 0.25", "max": "W * 0.9", "step": 0.5, "unit": "mm" }
  },
  "parts": [
    {
      "id": "body",
      "type": "body-strip",
      "topBand": "max(W + TFW, DFW)",
      "bottomBand": "max(W + TFW, DFW)",
      "offsetX": 0,
      "panels": [
        { "id": "left", "label": "Left", "width": "W", "height": "H" },
        { "id": "front", "label": "Front", "width": "L", "height": "H" },
        { "id": "right", "label": "Right", "width": "W", "height": "H" },
        { "id": "back", "label": "Back", "width": "L", "height": "H" }
      ]
    },
    { "id": "glue-tab", "type": "glue-tab", "attachTo": "back.right", "width": "GFW" },
    { "id": "top-tuck", "type": "tuck-flap", "attachTo": "front.top", "height": "W + TFW", "lipHeight": "TFW", "taper": "TFR", "scoreOffset": "TFW" },
    { "id": "top-dust-left", "type": "dust-flap", "attachTo": "left.top", "height": "DFW" },
    { "id": "top-dust-right", "type": "dust-flap", "attachTo": "right.top", "height": "DFW" },
    { "id": "bottom-tuck", "type": "tuck-flap", "attachTo": "back.bottom", "height": "W + TFW", "lipHeight": "TFW", "taper": "TFR", "scoreOffset": "W" },
    { "id": "bottom-dust-left", "type": "dust-flap", "attachTo": "left.bottom", "height": "DFW" },
    { "id": "bottom-dust-right", "type": "dust-flap", "attachTo": "right.bottom", "height": "DFW" }
  ],
  "folding": {
    "rootFace": "front",
    "strategy": "derive-from-attachments"
  }
}
