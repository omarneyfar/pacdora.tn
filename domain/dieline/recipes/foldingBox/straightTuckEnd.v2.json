{
  "id": "straight-tuck-end-v2",
  "schemaVersion": "dieline-recipe-1.0",
  "category": "folding-box",
  "family": "straight-tuck-end",
  "label": "Straight Tuck End Folding Carton Box",
  "productionReady": false,
  "verificationStatus": "geometry-needs-verification",
  "parameters": {
    "L": { "label": "Length(L)", "kind": "dimension", "input": "number", "default": 80, "step": 1, "unit": "mm" },
    "W": { "label": "Width(W)", "kind": "dimension", "input": "number", "default": 40, "step": 1, "unit": "mm" },
    "H": { "label": "Height(H)", "kind": "dimension", "input": "number", "default": 120, "step": 1, "unit": "mm" },
    "closureMode": {
      "label": "Closure dimensions",
      "kind": "closure",
      "input": "select",
      "default": "auto",
      "options": [
        { "label": "Auto", "value": "auto" },
        { "label": "Manual", "value": "manual" }
      ]
    },
    "TFW": { "label": "Tuck flap lip", "kind": "closure", "input": "number", "default": "clamp(W * 0.32, max(1, min(W, L, H) * 0.08), max(2, min(W, L, H) * 0.5))", "step": 0.5, "unit": "mm" },
    "TFR": { "label": "Tuck flap radius", "kind": "closure", "input": "number", "default": "clamp(W * 0.18, 0.5, min(W * 0.25, L * 0.18, H * 0.18))", "step": 0.5, "unit": "mm" },
    "GFW": { "label": "Glue tab width", "kind": "closure", "input": "number", "default": "clamp(min(W, L, H) * 0.25, 1.5, max(3, min(W, L, H) * 0.35))", "step": 0.5, "unit": "mm" },
    "DFW": { "label": "Dust flap depth", "kind": "closure", "input": "number", "default": "clamp(W * 0.58, max(1, W * 0.25), max(2, min(W * 0.75, H * 0.75, L * 0.75)))", "step": 0.5, "unit": "mm" }
  },
  "constraints": [
    {
      "id": "width-very-small-for-handling",
      "severity": "warning",
      "condition": "W < 15",
      "message": "Width is very small. Geometry can be generated, but closure handling should be reviewed.",
      "affectedParameters": ["W"]
    },
    {
      "id": "length-very-small-for-handling",
      "severity": "warning",
      "condition": "L < 20",
      "message": "Length is very small. Review body-panel usability before using this dieline.",
      "affectedParameters": ["L"]
    },
    {
      "id": "height-very-small-for-handling",
      "severity": "warning",
      "condition": "H < 25",
      "message": "Height is very small. Folding and loading may need manual review.",
      "affectedParameters": ["H"]
    },
    {
      "id": "height-width-ratio-too-large",
      "severity": "warning",
      "condition": "H / W > 6",
      "message": "Height is very large compared to width. The carton may be unstable or visually unrealistic.",
      "affectedParameters": ["H", "W"]
    },
    {
      "id": "height-width-ratio-too-small",
      "severity": "warning",
      "condition": "H / W < 0.7",
      "message": "Height is very small compared to width. The carton may look too shallow for a tuck-end structure.",
      "affectedParameters": ["H", "W"]
    },
    {
      "id": "length-width-ratio-too-large",
      "severity": "warning",
      "condition": "L / W > 5",
      "message": "Length is very large compared to width. Review body panel proportions before using this dieline.",
      "affectedParameters": ["L", "W"]
    },
    {
      "id": "width-length-ratio-too-large",
      "severity": "warning",
      "condition": "W / L > 2.5",
      "message": "Width is very large compared to length. Review side-panel proportions before using this dieline.",
      "affectedParameters": ["W", "L"]
    },
    {
      "id": "tuck-flap-too-large-for-body-height",
      "severity": "warning",
      "condition": "W + TFW > H * 0.85",
      "message": "Tuck flap height is large compared to body height. Closure proportions may be visually unrealistic.",
      "affectedParameters": ["W", "TFW", "H"]
    },
    {
      "id": "dust-flap-too-small",
      "severity": "warning",
      "condition": "DFW < W * 0.4",
      "message": "Dust flap depth is small compared to width. Closure support may be weak.",
      "affectedParameters": ["DFW", "W"]
    },
    {
      "id": "dust-flap-too-large",
      "severity": "warning",
      "condition": "DFW > W * 0.8",
      "message": "Dust flap depth is large compared to width. Closure proportions may look crowded.",
      "affectedParameters": ["DFW", "W"]
    },
    {
      "id": "glue-tab-too-small",
      "severity": "warning",
      "condition": "GFW < min(W, L, H) * 0.08",
      "message": "Glue tab is small compared to the carton. Bond strength may need review.",
      "affectedParameters": ["GFW", "L", "W", "H"]
    },
    {
      "id": "glue-tab-too-large",
      "severity": "warning",
      "condition": "GFW > min(W, L, H) * 0.45",
      "message": "Glue tab is large compared to the carton. Review overlap and artwork clearance.",
      "affectedParameters": ["GFW", "L", "W", "H"]
    }
  ],
  "parts": [
    {
      "id": "body",
      "type": "body-strip",
      "topBand": "max(W + TFW, DFW)",
      "bottomBand": "max(W + TFW, DFW)",
      "offsetX": "GFW",
      "panels": [
        { "id": "left", "label": "Left", "width": "W", "height": "H" },
        { "id": "front", "label": "Front", "width": "L", "height": "H" },
        { "id": "right", "label": "Right", "width": "W", "height": "H" },
        { "id": "back", "label": "Back", "width": "L", "height": "H" }
      ]
    },
    { "id": "glue-tab", "type": "glue-tab", "attachTo": "left.left", "width": "GFW" },
    { "id": "top-tuck", "type": "tuck-flap", "attachTo": "front.top", "height": "W + TFW", "lipHeight": "TFW", "taper": "TFR", "scoreOffset": "TFW" },
    { "id": "top-dust-left", "type": "dust-flap", "attachTo": "left.top", "height": "DFW" },
    { "id": "top-dust-right", "type": "dust-flap", "attachTo": "right.top", "height": "DFW" },
    { "id": "bottom-tuck", "type": "tuck-flap", "attachTo": "front.bottom", "height": "W + TFW", "lipHeight": "TFW", "taper": "TFR", "scoreOffset": "W" },
    { "id": "bottom-dust-left", "type": "dust-flap", "attachTo": "left.bottom", "height": "DFW" },
    { "id": "bottom-dust-right", "type": "dust-flap", "attachTo": "right.bottom", "height": "DFW" }
  ],
  "folding": {
    "rootFace": "front",
    "strategy": "derive-from-attachments"
  }
}
