{
  "id": "hang-tab-v2",
  "schemaVersion": "dieline-recipe-1.0",
  "category": "folding-box",
  "family": "folding-carton-box-with-hang-tab",
  "label": "Folding Carton with Hang Tab (experimental)",
  "productionReady": false,
  "verificationStatus": "geometry-needs-verification",
  "experimentalStatus": "reference-pending",
  "implementationStatus": "experimental-scaffold",
  "referenceNotes": [
    "This hidden recipe uses a hang-tab face and euro-slot-cutout primitive.",
    "The euro slot is an approximate reusable primitive and requires reference comparison."
  ],
  "parameters": {
    "L": { "label": "Length(L)", "kind": "dimension", "input": "number", "default": 120, "step": 1, "unit": "mm" },
    "W": { "label": "Width(W)", "kind": "dimension", "input": "number", "default": 60, "step": 1, "unit": "mm" },
    "H": { "label": "Height(H)", "kind": "dimension", "input": "number", "default": 160, "step": 1, "unit": "mm" },
    "closureMode": {
      "label": "Closure dimensions",
      "kind": "closure",
      "input": "select",
      "default": "auto",
      "options": [
        { "label": "Auto", "value": "auto" },
        { "label": "Manual", "value": "manual" }
      ]
    },
    "TFW": { "label": "Tuck flap lip", "kind": "closure", "input": "number", "default": "clamp(W * 0.32, max(1, min(W, L, H) * 0.08), max(2, min(W, L, H) * 0.5))", "step": 0.5, "unit": "mm" },
    "TFR": { "label": "Tuck flap radius", "kind": "closure", "input": "number", "default": "clamp(W * 0.18, 0.5, min(W * 0.25, L * 0.18, H * 0.18))", "step": 0.5, "unit": "mm" },
    "GFW": { "label": "Glue tab width", "kind": "closure", "input": "number", "default": "clamp(min(W, L, H) * 0.25, 1.5, max(3, min(W, L, H) * 0.35))", "step": 0.5, "unit": "mm" },
    "DFW": { "label": "Dust flap depth", "kind": "closure", "input": "number", "default": "clamp(W * 0.58, max(1, W * 0.25), max(2, min(W * 0.75, H * 0.75, L * 0.75)))", "step": 0.5, "unit": "mm" },
    "HTW": { "label": "Hang tab width", "kind": "closure", "input": "number", "default": "clamp(L * 0.48, max(24, L * 0.3), max(28, L * 0.65))", "step": 0.5, "unit": "mm" },
    "HTH": { "label": "Hang tab height", "kind": "closure", "input": "number", "default": "clamp(W * 0.6, max(22, W * 0.38), max(26, W * 0.78))", "step": 0.5, "unit": "mm" },
    "ESW": { "label": "Euro slot width", "kind": "closure", "input": "number", "default": "clamp(min(HTW, L) * 0.48, max(6, min(HTW, L) * 0.34), max(8, min(HTW, L) * 0.68))", "step": 0.5, "unit": "mm" },
    "ESH": { "label": "Euro slot height", "kind": "closure", "input": "number", "default": "clamp(HTH * 0.13, 3, max(4, HTH * 0.2))", "step": 0.25, "unit": "mm" },
    "SDS": { "label": "Cutout safe distance", "kind": "closure", "input": "number", "default": "clamp(min(L, W, H) * 0.03, 1.5, 4)", "step": 0.25, "unit": "mm" }
  },
  "constraints": [
    {
      "id": "reference-pending-template",
      "severity": "warning",
      "condition": "1",
      "message": "Hang tab and euro-slot geometry need reference comparison.",
      "affectedParameters": []
    },
    {
      "id": "euro-slot-large-for-tab",
      "severity": "warning",
      "condition": "ESW > HTW * 0.7",
      "message": "Euro slot is large relative to hang tab width.",
      "affectedParameters": ["ESW", "HTW"]
    },
    {
      "id": "height-width-ratio-too-large",
      "severity": "warning",
      "condition": "H / W > 6",
      "message": "Height is very large compared to width. Review hang-tab stability.",
      "affectedParameters": ["H", "W"]
    },
    {
      "id": "height-width-ratio-too-small",
      "severity": "warning",
      "condition": "H / W < 0.7",
      "message": "Height is very small compared to width. Review hang-tab layout.",
      "affectedParameters": ["H", "W"]
    }
  ],
  "parts": [
    {
      "id": "body",
      "type": "body-strip",
      "contract": "body-strip",
      "topBand": "max(W + TFW, DFW, HTH)",
      "bottomBand": "max(W + TFW, DFW)",
      "offsetX": "GFW",
      "panels": [
        { "id": "left", "label": "Left", "width": "W", "height": "H" },
        { "id": "front", "label": "Front", "width": "L", "height": "H" },
        { "id": "right", "label": "Right", "width": "W", "height": "H" },
        { "id": "back", "label": "Back", "width": "L", "height": "H" }
      ]
    },
    { "id": "glue-tab", "type": "glue-tab", "contract": "side-glue-tab", "attachTo": "left.left", "width": "GFW" },
    { "id": "top-tuck", "type": "full-width-tuck-flap", "contract": "full-width-tuck-flap", "attachTo": "front.top", "faceId": "top-tuck", "side": "top", "height": "W + TFW", "cornerRadius": "TFR", "scoreOffsetFromBase": "W" },
    { "id": "top-hang-anchor", "type": "partial-edge-anchor", "contract": "partial-edge-anchor", "attachTo": "back.top", "anchorId": "top-hang-anchor", "length": "HTW", "centered": true, "margin": "max(1, L * 0.12)" },
    { "id": "top-hang-tab", "type": "hang-tab", "contract": "hang-tab", "attachTo": "top-hang-anchor", "faceId": "top-hang-tab", "side": "top", "height": "HTH", "topWidth": "HTW * 0.78", "shoulder": "HTH * 0.22" },
    { "id": "euro-hang-slot", "type": "euro-slot-cutout", "contract": "euro-slot-cutout", "attachToFace": "top-hang-tab", "width": "ESW", "height": "ESH", "radius": "ESH / 2", "crownRadius": "ESH * 0.82", "crownOffset": "ESH * 0.14", "centerY": "HTH * 0.43", "margin": "SDS" },
    { "id": "top-dust-left", "type": "trapezoid-top-dust-flap", "contract": "trapezoid-top-dust-flap", "attachTo": "left.top", "height": "DFW", "taper": "TFR" },
    { "id": "top-dust-right", "type": "trapezoid-top-dust-flap", "contract": "trapezoid-top-dust-flap", "attachTo": "right.top", "height": "DFW", "taper": "TFR" },
    { "id": "bottom-tuck", "type": "full-width-tuck-flap", "contract": "full-width-tuck-flap", "attachTo": "back.bottom", "faceId": "bottom-tuck", "side": "bottom", "height": "W + TFW", "cornerRadius": "TFR", "scoreOffsetFromBase": "W" },
    { "id": "bottom-dust-left", "type": "angled-bottom-dust-flap", "contract": "angled-bottom-dust-flap", "attachTo": "left.bottom", "height": "DFW", "startInset": "TFR * 0.7", "endInset": "TFR" },
    { "id": "bottom-dust-right", "type": "angled-bottom-dust-flap", "contract": "angled-bottom-dust-flap", "attachTo": "right.bottom", "height": "DFW", "startInset": "TFR * 0.7", "endInset": "TFR" }
  ],
  "folding": {
    "rootFace": "front",
    "strategy": "derive-from-attachments"
  }
}
